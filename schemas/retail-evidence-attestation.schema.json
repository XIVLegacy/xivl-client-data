{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XIVLegacy/xivl-client-data/schemas/retail-evidence-attestation.schema.json",
  "title": "Retail evidence verification attestation, version 1",
  "description": "Strict sanitized output of the static-actor retail-input check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicRepositoryCommit", "approvedInputSha256", "toolVersions", "check", "result"],
  "properties": {
    "schemaVersion": {"const": 1},
    "publicRepositoryCommit": {"type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$"},
    "approvedInputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "verifier"],
      "properties": {
        "python": {"const": "3.12"},
        "verifier": {"const": "1.0"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "staticactor-class-paths-v1"},
        "version": {"const": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pass", "fail"]}
      }
    }
  }
}
