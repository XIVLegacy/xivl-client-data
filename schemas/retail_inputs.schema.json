{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XIVLegacy/xivl-client-data/schemas/retail_inputs.schema.json",
  "title": "Retail input grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inputs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "filename", "installRelativePath", "size", "sha256", "source", "allowedChecks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "installRelativePath": {"type": "string", "pattern": "^[^/].*[^/]$"},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "commit", "path"],
            "properties": {
              "repository": {"type": "string", "minLength": 1},
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "path": {"type": "string", "pattern": "^[^/].*[^/]$"}
            }
          },
          "allowedChecks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
